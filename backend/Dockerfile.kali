# Kali Linux rolling com as tools do catálogo + backend Ethoscan.
# Use com ETHOSCAN_DOCKERFILE=Dockerfile.kali (ver .env.example).
#
# Cobre o catálogo completo (incluindo Metasploit, ZAP, NetExec, BloodHound.py,
# unicornscan) e as ferramentas de inventário (tcpdump, netcat, aircrack-ng,
# kismet, wifite, bettercap, arpwatch, SET). É uma imagem grande (vários GB) e o
# build demora; para o pipeline clássico, Dockerfile.tools é mais leve.
# As ferramentas de inventário NÃO entram em jobs automatizados (RF/SET/MITM).
#
# Uso ético: apenas alvos autorizados. O worker precisa de NET_RAW/NET_ADMIN
# (já definido no docker-compose.yml).

FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

# Kali já traz main/contrib/non-free; garante non-free (nikto/zaproxy).
RUN set -eux; \
    if [ -f /etc/apt/sources.list ]; then \
      sed -i 's/ main$/ main contrib non-free non-free-firmware/' /etc/apt/sources.list; \
    fi; \
    for f in /etc/apt/sources.list.d/*.sources; do \
      [ -e "$f" ] || continue; \
      sed -i 's/^Components: main$/Components: main contrib non-free non-free-firmware/' "$f"; \
    done; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates curl \
      python3.13 python3.13-venv \
      nmap whatweb gobuster sslscan nuclei nikto masscan unicornscan \
      sqlmap hydra john dirb \
      metasploit-framework zaproxy netexec bloodhound.py \
      tcpdump netcat-openbsd aircrack-ng kismet wifite bettercap arpwatch set \
      libcap2-bin; \
    rm -rf /var/lib/apt/lists/*

# Worker roda com cap_drop:ALL + cap_add NET_RAW/NET_ADMIN/DAC_OVERRIDE
# (bounding set reduzido). Binários com file capabilities fora desse set
# (ex.: /usr/lib/nmap/nmap pede cap_net_bind_service) falham com EPERM no
# exec ("Operation not permitted", exit 126). O worker é root com as caps
# necessárias: file caps são redundantes — removemos para o exec funcionar.
RUN set -eux; getcap -r / 2>/dev/null | awk '{print $1}' | xargs -r -n1 setcap -r; \
    getcap -r / 2>/dev/null | grep . && exit 1 || true

# Wordlists esperadas pelo adapter Gobuster.
RUN mkdir -p /usr/share/wordlists/dirb \
    && if [ -f /usr/share/dirb/wordlists/common.txt ]; then \
         ln -sf /usr/share/dirb/wordlists/common.txt /usr/share/wordlists/dirb/common.txt; \
       fi \
    && if [ -f /usr/share/dirb/wordlists/small.txt ]; then \
         ln -sf /usr/share/dirb/wordlists/small.txt /usr/share/wordlists/dirb/small.txt; \
       fi

# Templates do Nuclei (o pacote Kali traz o binário, não todos os templates).
RUN (nuclei -update-templates || true)

COPY requirements.txt .
RUN python3.13 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

COPY . .

RUN mkdir -p /home/app /app/artifacts \
    && if ! getent passwd 1000 >/dev/null; then \
         useradd --uid 1000 --home-dir /home/app --shell /bin/bash app; \
       fi \
    && chown -R 1000:1000 /home/app /app
ENV PATH="/opt/venv/bin:$PATH"
USER 1000:1000

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

# Ethoscan — ambiente local
# Local sem Docker: sqlite. Com Docker: postgresql+psycopg://ethoscan:ethoscan@localhost:5432/ethoscan
DATABASE_URL=sqlite:///./ethoscan.db
REDIS_URL=redis://localhost:6379/0
ETHOSCAN_MODE=local
ETHOSCAN_ARTIFACTS_DIR=./artifacts
ETHOSCAN_ALLOW_MOCK=true
ETHOSCAN_API_HOST=127.0.0.1
ETHOSCAN_API_PORT=8000

# --- Worker de jobs (Sprint 2) ---
# Consome jobs `pending` do banco (não usa Redis) e recupera jobs órfãos no startup.
ETHOSCAN_WORKER_ENABLED=true
ETHOSCAN_WORKER_CONCURRENCY=1
ETHOSCAN_WORKER_POLL_INTERVAL=0.5
# Força mock mesmo com as ferramentas instaladas (demos/CI reproduzíveis).
ETHOSCAN_FORCE_MOCK=false

# --- Logs (Sprint 3) ---
# ETHOSCAN_LOG_FORMAT=json para logs estruturados (uma linha JSON por evento).
ETHOSCAN_LOG_LEVEL=INFO
ETHOSCAN_LOG_FORMAT=text

# --- Segurança (obrigatório para usar /api/*) ---
# A API falha fechada: sem esta chave, todo /api/* responde 503.
# Gere com: openssl rand -hex 32
ETHOSCAN_API_KEY=
# Origens liberadas no CORS (CSV). Evite "*" — só use em ambiente totalmente isolado.
ETHOSCAN_CORS_ORIGINS=http://localhost:3000
# Allowlist global (CSV) de hosts/CIDRs autorizados, revalidada na criação e antes de cada tool.
# Vazia = sem restrição adicional além do escopo do engagement.
# Ex.: ETHOSCAN_ALLOWLIST=lab.exemplo.com,10.10.0.0/24
ETHOSCAN_ALLOWLIST=

# --- Dashboard ---
# Usado pelo navegador (fica no bundle JS: ok para uso local; em multiusuário use auth real).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=
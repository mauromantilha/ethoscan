# Ethoscan — ambiente local
# Local sem Docker: sqlite. Com Docker: postgresql+psycopg://ethoscan:ethoscan@localhost:5432/ethoscan
DATABASE_URL=sqlite:///./ethoscan.db
REDIS_URL=redis://localhost:6379/0
# local = lab; remote/production = exige auth e não aceita chaves default.
ETHOSCAN_MODE=local
ETHOSCAN_ARTIFACTS_DIR=./artifacts
# false = exige tools reais (fail-closed). Para dev sem Kali, mude para true.
ETHOSCAN_ALLOW_MOCK=false
# Preferir 127.0.0.1 no uso diário; 0.0.0.0 só em lab isolado
ETHOSCAN_API_HOST=127.0.0.1
ETHOSCAN_API_PORT=8000
# Auth — ver README "Segurança do próprio Ethoscan"
# Gere uma key forte: openssl rand -hex 32
# Vazio = auth desligada apenas em mode=local (com aviso). Fora de local a API não sobe.
ETHOSCAN_API_KEY=
# true só é aceite em mode=local (lab isolado).
ETHOSCAN_DISABLE_AUTH=false
# Utilizador local (desktop) — NÃO coloque a password em claro.
# Gerar hash bcrypt (substitua YOUR_PASSWORD):
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
ETHOSCAN_LOCAL_USERNAME=mauro
ETHOSCAN_LOCAL_PASSWORD_HASH=
# 2FA TOTP (authenticator app) para o login local. Vazio = desativado.
# Gerar segredo: python3 -c "import pyotp; print(pyotp.random_base32())"
# URI: otpauth://totp/Ethoscan:<utilizador>?secret=<segredo>&issuer=Ethoscan
ETHOSCAN_LOCAL_TOTP_SECRET=
# Nome mostrado no authenticator (opcional; default Ethoscan)
ETHOSCAN_LOCAL_TOTP_ISSUER=Ethoscan
# Chaves de serviço extras (CSV) para integrações — ex.: n8n. Aceitas no X-API-Key
# junto da master key e do login local; revogáveis individualmente.
# Configurar apenas service keys também ativa auth.
ETHOSCAN_SERVICE_KEYS=
# Segredo para assinar webhooks (HMAC-SHA256). O receptor valida
# X-Ethoscan-Signature: sha256=HMAC(secret, timestamp + "." + corpo).
# Vazio = callback sem assinatura (compatível, menos seguro).
ETHOSCAN_CALLBACK_SECRET=
# Allowlist global de alvos (CSV) — vazio = sem restrição além do escopo do engagement.
# Revalidada na criação e na execução. Ex.: ETHOSCAN_ALLOWLIST=lab.exemplo.com,10.10.0.0/24
ETHOSCAN_ALLOWLIST=
# TTL dos tokens de sessão emitidos por POST /api/auth/login (horas)
ETHOSCAN_SESSION_TTL_HOURS=12
# Incrementar invalida todas as sessões existentes (Redis + fallback memória).
ETHOSCAN_SESSION_EPOCH=1
# Rate limit de login por IP (memória do processo; Caddy pode reforçar).
ETHOSCAN_LOGIN_MAX_ATTEMPTS=5
ETHOSCAN_LOGIN_WINDOW_SECONDS=60
# Credenciais em argv (BloodHound) ficam visíveis em `ps`; só habilite em lab isolado.
ETHOSCAN_ALLOW_CREDS_IN_ARGV=false
# CORS — origem da UI (não usar *)
ETHOSCAN_CORS_ORIGINS=http://localhost:3000
# Logs — json = uma linha por evento (job_id, tool, exit_code...)
ETHOSCAN_LOG_LEVEL=INFO
ETHOSCAN_LOG_FORMAT=text
# --- Assistente LLM (aikido) — advisory-only: tria findings, correlaciona e
# responde sobre o job. NUNCA executa scans. Qualquer endpoint OpenAI-compatível;
# vazio = feature desligada (nada é enviado a terceiros).
# Ollama local (recomendado para dados sensíveis):
#   ETHOSCAN_LLM_BASE_URL=http://host.docker.internal:11434/v1
#   ETHOSCAN_LLM_MODEL=llama3.1:8b
# Nuvem (OpenAI/Groq/etc.): aponte BASE_URL do provedor + API key forte.
ETHOSCAN_LLM_BASE_URL=
ETHOSCAN_LLM_API_KEY=
ETHOSCAN_LLM_MODEL=
ETHOSCAN_LLM_TIMEOUT_SECONDS=90
ETHOSCAN_LLM_MAX_TOKENS=2000
# --- Portas / exposição (docker compose) ---
# API_BIND: 127.0.0.1 = só na máquina | 0.0.0.0 = expõe na rede local (desktop remoto)
# A API exposta usa auth (ETHOSCAN_API_KEY e/ou login local).
API_BIND=127.0.0.1
API_PORT=8000
# WEB_BIND: a UI embute a NEXT_PUBLIC_API_KEY no bundle JS — deixe 127.0.0.1,
# a menos que aceite que qualquer um na rede leia essa chave.
WEB_BIND=127.0.0.1
WEB_PORT=3000
# Postgres do compose: publicado só no loopback (porta diferente do 5432 padrão p/ não colidir)
POSTGRES_PORT=15432
# Docker: Dockerfile = imagem slim (sem scanners; use um host Kali ou mock)
#         Dockerfile.tools = nmap/whatweb/gobuster/sslscan/nuclei + opcionais
#         Debian (nikto, masscan, sqlmap, hydra, john)
#         Dockerfile.kali = Kali rolling com o catálogo completo (Metasploit, ZAP,
#         NetExec, BloodHound.py, unicornscan); imagem grande, build demorado
#         Requer rebuild: docker compose up -d --build api worker
ETHOSCAN_DOCKERFILE=Dockerfile
# Redis é DEDICADO do Ethoscan e fica só na rede interna do compose (sem porta no host).
# ID estável do worker para recuperar jobs órfãos após crash/restart.
# Em compose o default é worker-1; para múltiplos workers use um ID único por réplica.
# ETHOSCAN_WORKER_ID=worker-1
NEXT_PUBLIC_API_URL=http://localhost:8000
# A UI embute esta key no bundle JS: use uma key dedicada e não a master key em produção.
NEXT_PUBLIC_API_KEY=

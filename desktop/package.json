{
  "name": "ethoscan",
  "version": "0.5.1",
  "private": true,
  "description": "Shell Electron local para o Ethoscan — dispara pentests éticos via API existente",
  "author": "Ethoscan <ethoscan@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/mauromantilha/ethoscan",
  "repository": {
    "type": "git",
    "url": "https://github.com/mauromantilha/ethoscan.git",
    "directory": "desktop"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:win": "electron-builder --win portable nsis --publish never"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "com.ethoscan.desktop",
    "productName": "Ethoscan",
    "copyright": "Copyright © Ethoscan",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "afterPack": "build/after-pack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "mauromantilha",
        "repo": "ethoscan"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "executableName": "ethoscan",
      "maintainer": "Ethoscan <ethoscan@users.noreply.github.com>",
      "synopsis": "Cliente Electron para a API Ethoscan (pentest ético local)",
      "description": "Shell desktop que chama a API Ethoscan local. Requer API + Redis + worker; não inclui scanners.",
      "desktop": {
        "Name": "Ethoscan",
        "Comment": "Cliente Ethoscan para pentest ético local",
        "Categories": "Network;Security;",
        "Keywords": "pentest;security;scan;ethoscan;",
        "StartupWMClass": "Ethoscan"
      },
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "ethoscan_${version}_${arch}.deb",
      "afterInstall": "build/after-install.sh",
      "priority": "optional",
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2 | libasound2t64"
      ]
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Ethoscan"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
